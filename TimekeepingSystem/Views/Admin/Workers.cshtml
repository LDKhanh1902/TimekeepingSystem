@model List<User>
@{
    ViewData["Title"] = "Quản lý công nhân";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="bi bi-people-fill"></i> Danh sách công nhân</h4>
        <span class="badge bg-light text-dark">@Model.Count người</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Lương/ca</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var worker in Model)
                    {
                        <tr>
                            <td>#@worker.Id</td>
                            <td>
                                <strong>@worker.FullName</strong><br/>
                                <small class="text-muted">@@@worker.Username</small>
                            </td>
                            <td>@(worker.Phone ?? "-")</td>
                            <td>@(worker.Email ?? "-")</td>
                            <td>@worker.SalaryPerShift.ToString("N0") ₫</td>
                            <td>
                                @if (worker.IsActive)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Không hoạt động</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="WorkerAttendance" asp-route-id="@worker.Id" class="btn btn-info text-white" title="Chấm công">
                                        <i class="bi bi-calendar-check"></i>
                                    </a>
                                    <a asp-action="SalarySlip" asp-route-id="@worker.Id" class="btn btn-success text-white" title="Phiếu lương">
                                        <i class="bi bi-cash-stack"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-question-circle"></i> Hướng dẫn</h5>
    </div>
    <div class="card-body">
        <ul class="mb-0">
            <li><i class="bi bi-calendar-check text-info"></i> <strong>Chấm công:</strong> Xem và chỉnh sửa chấm công theo từng tháng</li>
            <li><i class="bi bi-cash-stack text-success"></i> <strong>Phiếu lương:</strong> In phiếu lương theo tháng</li>
        </ul>
    </div>
</div>

