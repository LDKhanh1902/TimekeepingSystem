﻿@{
    ViewData["Title"] = "Trang chủ";
    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("UserId"));
    var role = Context.Session.GetString("Role") ?? "";
}

<div class="text-center">
    <div style="font-size: 5rem; color: #667eea;">
        <i class="bi bi-clock-history"></i>
    </div>
    <h1 class="display-4">Hệ thống Chấm Công</h1>
    <p class="lead">Quản lý chấm công và tính lương cho công nhân.</p>

    @if (isLoggedIn)
    {
        if (role == "Admin")
        {
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary btn-lg">
                <i class="bi bi-speedometer2"></i> Vào Dashboard Admin
            </a>
        }
        else
        {
            <a asp-controller="Worker" asp-action="Dashboard" class="btn btn-primary btn-lg">
                <i class="bi bi-speedometer2"></i> Vào Dashboard
            </a>
        }
    }
    else
    {
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg">
            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
        </a>
    }
</div>

